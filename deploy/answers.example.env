# Non-interactive answers for deploy/install.sh — TEMPLATE, placeholders only.
#   sudo cp deploy/answers.example.env /root/sparky-answers.env && sudo chmod 600 /root/sparky-answers.env
#   (edit it)   sudo ./deploy/install.sh --answers /root/sparky-answers.env --non-interactive
# Parsed as KEY=value lines WITHOUT shell evaluation. Delete the file after the install:
# secrets are copied into /etc/sparky/secrets.env and /etc/sparky/backend.env.
# Any key left out is asked interactively (or fails in --non-interactive mode).

SPARKY_MODE=staging
STORE_DOMAIN=staging.sparky3dcraft.tech
API_DOMAIN=api.staging.sparky3dcraft.tech
ADMIN_EMAIL=owner@example.com
ENABLE_TLS=yes
LETSENCRYPT_EMAIL=owner@example.com

# product media: s3 (OCI Object Storage via the S3-compatible API) or local (staging only)
FILE_PROVIDER=s3
S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.ap-mumbai-1.oraclecloud.com
S3_REGION=ap-mumbai-1
S3_BUCKET=sparky-media
S3_FILE_URL=https://objectstorage.ap-mumbai-1.oraclecloud.com/n/NAMESPACE/b/sparky-media/o
S3_PRIVATE_BUCKET=sparky-private
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_DISABLE_ACL=yes

# payments — test keys on staging, live keys only for production
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE
COD_ENABLED=false
COD_MAX_ORDER_AMOUNT=

# email (empty SMTP_HOST = no emails; password reset and activation will not work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sparky 3D Craft Co <orders@sparky3dcraft.tech>
MERCHANT_NOTIFICATION_EMAIL=owner@example.com

# shipping — MERCHANT MUST SUPPLY. No default is invented; install stops if empty.
SHIPPING_STANDARD_AMOUNT=
SHIPPING_FREE_THRESHOLD=
WAREHOUSE_CITY=Bengaluru
WAREHOUSE_POSTCODE=560086

# migration: public (no credentials, products+collections only), admin, csv, skip
MIGRATION_SOURCE=public
SHOPIFY_STORE_URL=https://sparky3dcraft.tech
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_IMPORT_ENTITIES=products,collections,customers,orders
SHOPIFY_CSV_PATH=

ENABLE_BACKUPS=yes
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=sparky-backups
