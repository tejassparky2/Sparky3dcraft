# Storefront (Next.js) environment. Copy to .env.local for development.
# Only NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.sparky3dcraft.tech
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://sparky3dcraft.tech
# comma-separated URL prefixes of product media (Medusa file storage)
MEDUSA_IMAGE_HOSTS=https://objectstorage.ap-mumbai-1.oraclecloud.com/n/NAMESPACE/b/BUCKET/o/
# shared secret with the Medusa backend (catalog revalidation)
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_64_HEX
CATALOG_REVALIDATE_SECONDS=30
# true on STAGING only (robots disallow + noindex)
SITE_NOINDEX=false
STORE_COUNTRY_CODE=in
