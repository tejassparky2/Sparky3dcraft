:\u003c\/p\u003e\n\u003cp\u003e​Locally Crafted: Proudly designed and 3D printed in Bengaluru.\u003c\/p\u003e\n\u003cp\u003e​Pan-India Shipping: Securely packaged and shipped across India.\u003c\/p\u003e\n\u003cp\u003e​Bengaluru Locals: Local pickup options are available at checkout!\u003c\/p\u003e","published_at":"2026-07-05T22:19:38+05:30","created_at":"2026-07-05T22:14:48+05:30","updated_at":"2026-09-24T20:41:50+05:30","vendor":"SPARKY 3D CRAFT CO","product_type":"","tags":["lamp","lord shiva","mahadev","mahadev lamp","night lamp","Shiva","shiva lamp"],"variants":[{"id":41295992029248,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"999.00","grams":0,"compare_at_price":"1699.00","position":1,"product_id":7268871143488,"created_at":"2026-07-05T22:14:49+05:30","updated_at":"2026-09-24T20:41:50+05:30"}],"images":[{"id":36455381762112,"created_at":"2026-07-05T22:15:50+05:30","position":1,"updated_at":"2026-07-05T22:15:52+05:30","product_id":7268871143488,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0607\/3679\/8784\/files\/rn-image_picker_lib_temp_3c718822-6153-4390-aa27-b02b3cc2e5b1.jpg?v=1783269952","width":3000,"height":4000},{"id":36455381729344,"created_at":"2026-07-05T22:15:50+05:30","position":2,"updated_at":"2026-07-05T22:15:52+05:30","product_id":7268871143488,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0607\/3679\/8784\/files\/rn-image_picker_lib_temp_d322451a-8f8a-4aaa-bdf6-a990d7b4a2d3.jpg?v=1783269952","width":2304,"height":4096},{"id":36455381696576,"created_at":"2026-07-05T22:15:50+05:30","position":3,"updated_at":"2026-07-05T22:15:52+05:30","product_id":7268871143488,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0607\/3679\/8784\/files\/rn-image_picker_lib_temp_356db0aa-8182-4c3a-a2af-9c332f5ad933.jpg?v=1783269952","width":3000,"height":4000}],"options":[{"name":"Titl