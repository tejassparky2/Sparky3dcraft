# Medusa backend environment — TEMPLATE ONLY. Placeholders, no real values.
# Development: copy to apps/backend/.env.   Production: generated by deploy/install.sh
# into /etc/sparky/backend.env (0640 root:sparky) — never commit a filled-in copy.
# In production the backend refuses to start with weak/default secrets (src/lib/env.ts).

NODE_ENV=development
STORE_NAME=Sparky 3D Craft Co

# --- database / redis (both bound to 127.0.0.1 only) ---
DATABASE_URL=postgres://medusa:REPLACE_DB_PASSWORD@127.0.0.1:5432/medusa_db
DB_POOL_MAX=10
# Required in production. Separate logical DBs per concern; Redis must use maxmemory-policy noeviction.
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0
EVENTS_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/1
WE_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/2
LOCKING_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/3
CACHE_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/4

# --- secrets: >= 32 random chars each (openssl rand -hex 32) ---
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_HEX
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_64_HEX

# --- URLs / CORS (no wildcards in production) ---
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
STOREFRONT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
MEDUSA_DISABLE_TELEMETRY=true

# --- process role (set by the systemd units) ---
# MEDUSA_WORKER_MODE=server|worker|shared
# DISABLE_MEDUSA_ADMIN=true

# --- file storage: local (dev) or s3 (OCI Object Storage S3-compatible API) ---
FILE_PROVIDER=local
# S3_FILE_URL=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com/sparky-media
# S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com
# S3_REGION=ap-mumbai-1
# S3_BUCKET=sparky-media
# S3_ACCESS_KEY_ID=REPLACE_CUSTOMER_SECRET_KEY_ID
# S3_SECRET_ACCESS_KEY=REPLACE_CUSTOMER_SECRET_KEY
# S3_PREFIX=media/
# S3_FORCE_PATH_STYLE=true
# S3_DISABLE_ACL=true
# private bucket for customer personalization photos (never public)
# S3_PRIVATE_BUCKET=sparky-private
PRIVATE_UPLOADS_DIR=./private-uploads
UPLOAD_RETENTION_DAYS=180

# --- payments ---
# Razorpay (test keys rzp_test_... on staging; live keys only on production)
# RAZORPAY_KEY_ID=rzp_test_REPLACE
# RAZORPAY_KEY_SECRET=REPLACE
# RAZORPAY_WEBHOOK_SECRET=REPLACE
# Cash on Delivery (authorized at order time, captured when cash is collected)
COD_ENABLED=false
# COD_MAX_ORDER_AMOUNT=5000
# Removes Medusa's no-money "system" provider from the region (always true in production)
SPARKY_DISABLE_SYSTEM_PAYMENT=false

# --- email (SMTP). Without SMTP_HOST no emails are sent. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=REPLACE
# SMTP_PASS=REPLACE
# SMTP_FROM=Sparky 3D Craft Co <orders@example.com>
# MERCHANT_NOTIFICATION_EMAIL=owner@example.com

# --- store setup / migration scripts ---
# SPARKY_STORE_CONFIG=/etc/sparky/store.config.json
# SPARKY_PUBLISHABLE_KEY_FILE=/var/lib/sparky/publishable_key
# SHOPIFY_SOURCE=public|admin|csv
# SHOPIFY_STORE_URL=https://sparky3dcraft.tech
# SHOPIFY_SHOP_DOMAIN=REPLACE.myshopify.com
# SHOPIFY_ADMIN_TOKEN=REPLACE (read-only scopes; never commit)
# SHOPIFY_API_VERSION=2026-07
# SPARKY_CUTOVER_COMPLETED=false
